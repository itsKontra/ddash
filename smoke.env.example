# The homelab systems `make smoke` and `make record` run against. Copy this
# file to smoke.env (gitignored, chmod 600) and replace every <placeholder>.
# Never commit smoke.env or scrub.map, and never run either target in CI.
#
# Each system Component's config is its protojson, in single quotes: the
# same fields as its config form (the proto's field names in lowerCamelCase).

SMOKE_DOCKER_API='{"hosts": [{"name": "<host-name>", "url": "tcp://<socket-proxy-ip>:2375"}]}'
SMOKE_PFSENSE_API='{"url": "https://<firewall-ip>", "apiKey": "<api-key>"}'
SMOKE_ADGUARD_API='{"url": "https://<adguard-ip>", "username": "<user>", "password": "<password>"}'
SMOKE_PROXMOX_API='{"url": "https://<node-ip>:8006", "tlsServerName": "<node-hostname>", "tokenId": "<user>@<realm>!<token-name>", "tokenSecret": "<token-secret>"}'
# nginx-config signs in with its own key, kept in .smoke/nginx-config.db.
# The first run fails with its authorized_keys line ("setup hint"): add it
# on the host once, as for ddash itself.
SMOKE_NGINX_CONFIG='{"host": "<nginx-host>", "hostKey": "ssh-ed25519 <host-key>"}'
# ddash's own user in Nginx Proxy Manager (Item Visibility: All Items,
# Proxy Hosts: Manage, SSL Certificates: View, 2FA off).
SMOKE_NGINX_PROXY_MANAGER_API='{"url": "http://<nginx-ip>:81", "email": "<user-email>", "password": "<password>"}'

# `make smoke-writes` only. A LAN address no Device holds (no lease, no
# static mapping, no AdGuard client), on an interface with pfSense's DHCP
# server enabled: the round trips borrow it for a static mapping of a fake
# 02:… MAC and for an AdGuard client, and delete both again. Its other
# targets are fixed: the DDASH_SMOKE alias and the stopped ddash-smoke LXC
# (docs/deployment.md, Smoke targets).
SMOKE_UNUSED_IP=<unused-lan-ip>
# `make smoke-writes` only. A hostname no Proxy Host, Redirection Host or
# 404 Host holds (e.g. ddash-smoke.<domain>): the round trip creates a
# Proxy Host for it, forwarding to SMOKE_UNUSED_IP, edits it and deletes it.
SMOKE_PROXY_HOST=<unused-hostname>

# Recording only (`make record`). The key MACs and addresses outside
# SCRUB_SUBNETS are hashed with; keep it, so re-recordings stay stable.
SCRUB_KEY=<long-random-string>
# Each real subnet and the N of the 198.18.N.0/24 it becomes (host octets
# are kept). The fixtures use 1 for the LAN and 2 for the servers.
SCRUB_SUBNETS=<lan-subnet>/24=1 <server-subnet>/24=2
# The homelab's domains, each becoming home.example.
SCRUB_DOMAINS=<domain>

# scrub.map (gitignored, next to this file) holds every other real name the
# fixtures must not keep (hosts, nodes, people, Wi-Fi networks), one per
# line as "real = replacement"; # starts a comment. Matching ignores case
# and needs the name to stand alone. A recorded file that still holds one
# is not written.
