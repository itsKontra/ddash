# ddash's bootstrap config, read by compose's env_file. Copy it to
# /opt/ddash/ddash.env (chmod 600) and replace every <placeholder>.
# Component credentials never go here: enter them in the UI.

# Where the Operator reaches ddash: its nginx Proxy Host.
DDASH_PUBLIC_URL=https://ddash.<domain>

# Keycloak: the realm's public URL (the issuer the browser sees), and
# ddash's confidential client (client role "operator" for the Operator).
DDASH_OIDC_ISSUER=https://<keycloak-host>/realms/<realm>
DDASH_OIDC_CLIENT_ID=<client-id>
DDASH_OIDC_CLIENT_SECRET=<client-secret>

# The reverse proxy, the only peer whose X-Forwarded-For/-Proto is trusted.
DDASH_TRUSTED_PROXY=<nginx-ip>

# A fine-grained PAT (Contents: read on itsKontra/ddash) for downloading the
# Release while the repo is private. Remove it once the repo is public.
DDASH_GITHUB_TOKEN=<github-token>
