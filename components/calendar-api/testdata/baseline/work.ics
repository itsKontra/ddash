BEGIN:VCALENDAR
VERSION:2.0
PRODID:-//ddash//calendarfake//EN
CALSCALE:GREGORIAN
X-WR-CALNAME:Work
X-WR-TIMEZONE:Europe/Berlin
BEGIN:VTIMEZONE
TZID:Europe/Berlin
BEGIN:DAYLIGHT
TZOFFSETFROM:+0100
TZOFFSETTO:+0200
TZNAME:CEST
DTSTART:19700329T020000
RRULE:FREQ=YEARLY;BYMONTH=3;BYDAY=-1SU
END:DAYLIGHT
BEGIN:STANDARD
TZOFFSETFROM:+0200
TZOFFSETTO:+0100
TZNAME:CET
DTSTART:19701025T030000
RRULE:FREQ=YEARLY;BYMONTH=10;BYDAY=-1SU
END:STANDARD
END:VTIMEZONE
BEGIN:VEVENT
UID:standup@home.example
DTSTAMP:{{stamp}}
DTSTART;TZID=Europe/Berlin:{{local -30 "09:30"}}
DTEND;TZID=Europe/Berlin:{{local -30 "09:45"}}
RRULE:FREQ=WEEKLY;BYDAY=MO,TU,WE,TH,FR
SUMMARY:Stand-up
END:VEVENT
BEGIN:VEVENT
UID:review@home.example
DTSTAMP:{{stamp}}
DTSTART:{{at 3 "14:00"}}
DTEND:{{at 3 "15:30"}}
SUMMARY:Quarterly review
LOCATION:Room 2
END:VEVENT
BEGIN:VEVENT
UID:offsite@home.example
DTSTAMP:{{stamp}}
DTSTART:{{at 9 "09:00"}}
DTEND:{{at 10 "17:00"}}
SUMMARY:Team offsite
LOCATION:Lakeside hotel
END:VEVENT
BEGIN:VEVENT
UID:cancelled@home.example
DTSTAMP:{{stamp}}
DTSTART:{{at 1 "11:00"}}
DTEND:{{at 1 "12:00"}}
STATUS:CANCELLED
SUMMARY:Cancelled 1:1
END:VEVENT
END:VCALENDAR
